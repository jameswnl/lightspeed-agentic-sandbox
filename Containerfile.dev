FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash curl git jq iproute2 util-linux && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -m -u 1000 sandbox

COPY pyproject.toml README.md ./
COPY src/ src/

RUN pip install --no-cache-dir '.[openai]'

# All available skills, baked in at /skills (outside /app so per-agent
# Landlock scoping in OpenShellSpawner doesn't need to touch /app's own
# grant). Nothing writes here at runtime.
COPY skills/ /skills/

# Copies the allowed_skills subset from /skills into /app/skills at
# spawn time -- providers discover skills by listing LIGHTSPEED_SKILLS_DIR,
# and Landlock can't grant partial listing of /skills without granting
# full listing, so OpenShellSpawner execs this before starting the agent
# server. /app/skills must be writable by the sandbox user for that copy
# to succeed.
COPY scripts/materialize-skills.sh /usr/local/bin/materialize-skills.sh
RUN chmod 0755 /usr/local/bin/materialize-skills.sh

RUN mkdir -p /app/skills /tmp /sandbox && \
    chown -R sandbox:sandbox /app /tmp /sandbox && \
    chmod -R g+w /app/skills && \
    chmod -R a+rX /skills

ENV LIGHTSPEED_AGENT_PROVIDER=openai
# Providers list this directory to discover skills -- must be the
# filtered /app/skills copy, not the read-only /skills master (see
# materialize-skills.sh). OpenShellSpawner also sets this explicitly on
# every spawn; this default covers anything that runs the image without
# going through that step (e.g. this repo's own e2e-containers.sh).
ENV LIGHTSPEED_SKILLS_DIR=/app/skills
ENV PYTHONPATH="/app/src"

USER sandbox

EXPOSE 8080

CMD ["sleep", "infinity"]
